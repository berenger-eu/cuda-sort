#!/bin/bash
#SBATCH -N 1
#SBATCH --time=24:00:00
#SBATCH --exclusive
#SBATCH --mail-user=berenger.bramas@inria.fr
#SBATCH --mail-type=all
#SBATCH -C rtx8000

source /projets/schnaps/cuda-sort/modules

mkdir /projets/schnaps/cuda-sort/buildrtx
cd /projets/schnaps/cuda-sort/buildrtx
